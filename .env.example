# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bodymax

# JWT secret - use a long random string
JWT_SECRET=change-me-to-a-long-random-secret

# Seed promoter account (for npm run seed)
SEED_PROMOTER_EMAIL=promoter@bodymax.com
SEED_PROMOTER_PASSWORD=promoter123
SEED_PROMOTER_NAME=Promoter
